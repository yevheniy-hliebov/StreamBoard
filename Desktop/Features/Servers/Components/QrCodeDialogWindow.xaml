<ui:FluentWindow
    x:Class="StreamTabula.Features.Servers.Components.QrCodeDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StreamTabula.Components.Controls"
    xmlns:titlebar="clr-namespace:StreamTabula.Components.TitleBar"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="350"
    Height="400"
    MinWidth="350"
    MinHeight="400"
    MaxWidth="400"
    MaxHeight="500"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <titlebar:MainTitleBar Title="{Binding Title}" Grid.Row="0" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24">

            <TextBlock
                Margin="0,0,0,16"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                FontSize="15"
                Text="{Binding Message}" />

            <Border 
                Margin="0,0,0,24" 
                Padding="8" 
                Background="White" 
                CornerRadius="8" 
                HorizontalAlignment="Center">
                <Image
                    Width="200"
                    Height="200"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    Source="{Binding QrImage}" />
            </Border>

            <ui:Button
                HorizontalAlignment="Center"
                Width="100"
                Appearance="Primary"
                IsDefault="True"
                IsCancel="True"
                Click="CloseButton_Click"
                Content="Close" />

        </StackPanel>
    </Grid>
</ui:FluentWindow>