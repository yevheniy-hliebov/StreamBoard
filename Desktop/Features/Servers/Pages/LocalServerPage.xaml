<Page
    x:Class="StreamTabula.Features.Servers.Pages.LocalServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="clr-namespace:StreamTabula.Components.Cards"
    xmlns:controls="clr-namespace:StreamTabula.Components.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StreamTabula.Features.Servers.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:page_components="clr-namespace:StreamTabula.Features.Servers.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LocalServerPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <StackPanel Margin="16">
        <StackPanel.Resources>
            <Style TargetType="cards:CardControl">
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
        </StackPanel.Resources>

        <controls:PageTitle Text="Local Server (HTTP / WebSocket)" />

        <cards:CardControl Title="Server Status" Description="{Binding ServerStatusString}">
            <cards:CardControl.ActionContent>
                <ui:Button Command="{Binding ToggleServerCommand}" Content="{Binding ActionButtonText}">
                    <ui:Button.Icon>
                        <controls:FluentIcon FontSize="12" IconType="{Binding ActionButtonIcon}" />
                    </ui:Button.Icon>
                </ui:Button>
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardControl Title="Auto Start" Description="Automatically start the server when StreamTabula starts up">
            <cards:CardControl.ActionContent>
                <controls:LabeledToggle IsChecked="{Binding AutoStart, Mode=TwoWay}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardControl Title="Address" Description="The local IP address used to connect your devices">
            <cards:CardControl.ActionContent>
                <ui:TextBox
                    Width="128"
                    IsEnabled="{Binding CanEditSettings}"
                    Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardControl Title="Port" Description="The network port used for server communication">
            <cards:CardControl.ActionContent>
                <ui:TextBox
                    Width="128"
                    IsEnabled="{Binding CanEditSettings}"
                    Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardExpander Title="HTTP Requests" Description="View a real-time log of incoming connection http requests">
            <controls:ConstrainedScrollBorder
                MinHeight="150"
                MaxHeight="300"
                ContentPadding="8">
                <page_components:HttpRequestLogList Logs="{Binding HttpRequestLogs}" />
            </controls:ConstrainedScrollBorder>
        </cards:CardExpander>
    </StackPanel>
</Page>
