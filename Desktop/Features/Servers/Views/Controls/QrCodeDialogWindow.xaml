<dialogs:BaseDialog x:Class="StreamTabula.Features.Servers.Views.Controls.QrCodeDialogWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:StreamTabula.Controls.Dialogs"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    Height="400"
                    MinHeight="400"
                    MaxHeight="500">

    <dialogs:BaseDialogContent Title="{Binding Title}">
        <dialogs:BaseDialogContent.DialogContent>
            <StackPanel>
                <TextBlock Margin="0,0,0,16"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Text="{Binding Message}" />

                <Border Margin="0,0,0,24"
                        Padding="8"
                        Background="White"
                        CornerRadius="8"
                        HorizontalAlignment="Center">
                    <Image Width="200"
                           Height="200"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Source="{Binding QrImage}" />
                </Border>
            </StackPanel>
        </dialogs:BaseDialogContent.DialogContent>

        <dialogs:BaseDialogContent.Buttons>
            <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <ui:Button Width="100"
                           IsDefault="True"
                           Click="Submit"
                           Content="Close" />
            </StackPanel>
        </dialogs:BaseDialogContent.Buttons>
    </dialogs:BaseDialogContent>
</dialogs:BaseDialog>