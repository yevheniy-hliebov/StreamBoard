<ui:FluentWindow
    x:Class="StreamTabula.Features.Variables.Views.Components.AddVariableDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StreamTabula.Components.Controls"
    xmlns:titlebar="clr-namespace:StreamTabula.Components.TitleBar"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="400"
    Height="300"
    MinWidth="350"
    MinHeight="250"
    MaxWidth="500"
    MaxHeight="400"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <titlebar:MainTitleBar Grid.Row="0"
                               Title="Add Global Variable"
                               ShowMinimize="False"
                               ShowMaximize="False"
                               ShowAppIcon="False"/>

        <StackPanel Grid.Row="1" Margin="24">

            <TextBlock Margin="0,0,0,4" Text="Variable Name" FontWeight="Medium" />
            <ui:TextBox 
                x:Name="NameTextBox" 
                PlaceholderText="e.g. my_counter" 
                Margin="0,0,0,16" />

            <TextBlock Margin="0,0,0,4" Text="Initial Value" FontWeight="Medium" />
            <ui:TextBox 
                x:Name="ValueTextBox" 
                PlaceholderText="e.g. 0, true, or Hello" 
                Margin="0,0,0,24" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Width="100"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Content="Cancel" />
                <ui:Button
                    Width="100"
                    Appearance="Primary"
                    IsDefault="True"
                    Click="SaveButton_Click"
                    Content="Save" />
            </StackPanel>

        </StackPanel>
    </Grid>
</ui:FluentWindow>