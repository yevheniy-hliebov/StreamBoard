<Page x:Class="StreamTabula.Features.Settings.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:cards="clr-namespace:StreamTabula.Controls.Cards"
      xmlns:local_controls="clr-namespace:StreamTabula.Features.Settings.Views.Controls"
      xmlns:typography="clr-namespace:StreamTabula.Controls.Typography"
      xmlns:inputs="clr-namespace:StreamTabula.Controls.Inputs"
      xmlns:icons="clr-namespace:StreamTabula.Controls.Icons"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="SettingsPage">

    <StackPanel Margin="16">
        <StackPanel.Resources>
            <Style TargetType="cards:CardControl">
                <Setter Property="Margin"
                        Value="0,0,0,12" />
            </Style>
        </StackPanel.Resources>

        <typography:PageTitle Text="Settings" />

        <typography:SectionHeader Text="General" />

        <cards:CardControl Title="Startup page"
                           Description="Choose which page to open when the app starts">
            <cards:CardControl.ActionContent>
                <ComboBox Width="150"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableStartupPages}"
                          SelectedItem="{Binding StartupPage, Mode=TwoWay}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardControl Title="Minimize to Tray"
                           Description="Hide to system tray when minimized">
            <cards:CardControl.ActionContent>
                <inputs:LabeledToggle IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardControl Title="Start minimized"
                           Description="Launch the app hidden in the background on startup">
            <cards:CardControl.ActionContent>
                <inputs:LabeledToggle IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <typography:SectionHeader Text="System" />

        <cards:CardControl Title="Startup with Windows"
                           Description="Launch StreamTabula automatically when Windows starts up">
            <cards:CardControl.ActionContent>
                <inputs:LabeledToggle IsChecked="{Binding StartupWithWindows, Mode=TwoWay}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardControl Title="Run as an administrator"
                           Description="Grant permission to intercept and block input from specific keyboards">
            <cards:CardControl.ActionContent>
                <inputs:LabeledToggle IsChecked="{Binding RunAsAdmin, Mode=TwoWay}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <local_controls:PrivilegeStatusInfo Margin="8,-8,0,12"
                                            IsRunAsAdmin="{Binding IsRunAsAdmin}"
                                            RestartAsAdminCommand="{Binding RestartAsAdminCommand}" />

        <typography:SectionHeader Text="Appearance" />

        <cards:CardControl Title="Theme"
                           Description="Switch between light and dark appearance">
            <cards:CardControl.ActionContent>
                <inputs:LabeledToggle IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                        ToggleOffText="Light"
                                        ToggleOnText="Dark" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <typography:SectionHeader Text="Updates" />

        <cards:CardControl Title="Update channel"
                           Description="Select which application updates you would like to receive">
            <cards:CardControl.ActionContent>
                <ComboBox Width="150"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableUpdateChannels}"
                          SelectedItem="{Binding UpdateChannel, Mode=TwoWay}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardControl Title="Check for updates"
                           Description="{Binding CurrentVersion}">
            <cards:CardControl.ActionContent>
                <ui:Button Appearance="Secondary"
                           Command="{Binding CheckForUpdatesCommand}"
                           Content="Check for update">
                    <ui:Button.Icon>
                        <icons:FluentIcon FontSize="12"
                                             IconType="UpdateRestore" />
                    </ui:Button.Icon>
                </ui:Button>
            </cards:CardControl.ActionContent>
        </cards:CardControl>
    </StackPanel>
</Page>
