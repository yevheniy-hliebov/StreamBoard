<dialogs:BaseDialog x:Class="StreamTabula.Features.Updater.Views.Components.UpdateDialogWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:StreamTabula.Controls.Dialogs"
                    xmlns:icons="clr-namespace:StreamTabula.Controls.Icons"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    Height="230"
                    MinHeight="230"
                    MaxHeight="300">

    <dialogs:BaseDialogContent Title="Check for Updates"
                               ButtonsPadding="0">

        <dialogs:BaseDialogContent.DialogContent>
            <Grid>

                <StackPanel Margin="0,16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DialogState}"
                                             Value="Loading">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ui:ProgressRing Margin="0,0,0,16"
                                     IsIndeterminate="True" />
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               Text="Checking for updates..." />
                </StackPanel>

                <StackPanel Margin="0,16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DialogState}"
                                             Value="UpToDate">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <icons:FluentIcon Margin="0,0,0,16"
                                         HorizontalAlignment="Center"
                                         FontSize="48"
                                         Foreground="#4CAF50"
                                         IconType="CheckMark" />

                    <TextBlock Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="No new updates available" />
                    <TextBlock Margin="0,0,0,24"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="You are currently running the latest version." />

                    <ui:Button Width="100"
                               HorizontalAlignment="Center"
                               Click="Submit"
                               Content="OK" />
                </StackPanel>

                <StackPanel Margin="0,16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DialogState}"
                                             Value="UpdateAvailable">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <icons:FluentIcon Margin="0,0,0,16"
                                         HorizontalAlignment="Center"
                                         FontSize="48"
                                         IconType="Cloud" />

                    <TextBlock Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold">
                            <Run Text="New version available:" />
                            <Run Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Text="{Binding LatestReleaseInfo.TagName}" />
                    </TextBlock>

                    <TextBlock Margin="0,0,0,24"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Would you like to install the new version now?" />

                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0"
                                   Appearance="Primary"
                                   Command="{Binding UpdateNowCommand}"
                                   Content="Update now" />
                        <ui:Button Margin="0,0,8,0"
                                   Click="Submit"
                                   Command="{Binding SkipVersionCommand}"
                                   Content="Skip this version" />
                        <ui:Button Click="Cancel"
                                   IsCancel="True"
                                   Content="Later" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DialogState}"
                                             Value="Downloading">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <icons:FluentIcon Margin="0,0,0,16"
                                         HorizontalAlignment="Center"
                                         FontSize="48"
                                         IconType="Download" />

                    <TextBlock Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Updating StreamTabula..." />

                    <TextBlock Margin="0,0,0,16"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding DownloadStatusText}" />

                    <ProgressBar Width="280"
                                 Height="8"
                                 Margin="0,0,0,4"
                                 Maximum="100"
                                 Minimum="0"
                                 Value="{Binding DownloadProgress}" />

                    <TextBlock HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding DownloadProgress, StringFormat={}{0:F1}%}" />
                </StackPanel>

            </Grid>
        </dialogs:BaseDialogContent.DialogContent>
    </dialogs:BaseDialogContent>

</dialogs:BaseDialog>
