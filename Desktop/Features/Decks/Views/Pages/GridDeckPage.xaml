<Page
    x:Class="StreamTabula.Features.Decks.Views.Pages.GridDeckPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:action_library="clr-namespace:StreamTabula.Features.Actions.Views.Components.Library"
    xmlns:canvas="clr-namespace:StreamTabula.Features.Decks.Views.Components.Canvas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:deck_profile="clr-namespace:StreamTabula.Features.Decks.Views.Components.DeckProfile"
    xmlns:layout="clr-namespace:StreamTabula.Features.Decks.Views.Components.Layout"
    xmlns:local="clr-namespace:StreamTabula.Features.Decks.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:property_editor="clr-namespace:StreamTabula.Features.Decks.Views.Components.PropertyEditor"
    Title="GridDeckPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding EditorState.ToggleClickCommand}" />
    </Page.InputBindings>

    <layout:DeckEditorLayout
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        IsClickMode="{Binding EditorState.IsClickMode}">

        <layout:DeckEditorLayout.LeftBarContent>
            <deck_profile:DeckProfilyView DataContext="{Binding Pages}" />
        </layout:DeckEditorLayout.LeftBarContent>

        <layout:DeckEditorLayout.CanvasContent>
            <canvas:GridCanvasView DataContext="{Binding Canvas}" />
        </layout:DeckEditorLayout.CanvasContent>

        <layout:DeckEditorLayout.PropertiesContent>
            <property_editor:PropertyEditorView DataContext="{Binding}" />
        </layout:DeckEditorLayout.PropertiesContent>

        <layout:DeckEditorLayout.LibraryContent>
            <action_library:ActionLibraryView DataContext="{Binding Library}" />
        </layout:DeckEditorLayout.LibraryContent>

    </layout:DeckEditorLayout>
</Page>
