<UserControl
    x:Class="StreamBoard.Features.Decks.Views.Components.PropertyEditor.ActionPropertiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:StreamBoard.Features.Decks.ViewModels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="No settings available for this action.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActionSettings.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ActionSettings}">
                <ItemsControl.Resources>

                    <DataTemplate DataType="{x:Type settings:StringSettingViewModel}">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Label}" />

                            <ui:TextBox PlaceholderText="{Binding Hint}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type settings:IntSettingViewModel}">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Label}" />

                            <ui:NumberBox
                                ClearButtonEnabled="False"
                                PlaceholderText="{Binding Hint}"
                                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type settings:BoolSettingViewModel}">
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <ui:ToggleSwitch IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Label}" />
                        </StackPanel>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type settings:DropdownSettingViewModel}">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Label}" />

                            <ui:DropDownButton
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Icon="FitPage24">

                                <ui:DropDownButton.Content>
                                    <TextBlock
                                        HorizontalAlignment="Stretch"
                                        Text="{Binding Value, TargetNullValue='Select scene...'}"
                                        TextAlignment="Left" />
                                </ui:DropDownButton.Content>

                                <ui:DropDownButton.Flyout>
                                    <ContextMenu
                                        MaxHeight="300"
                                        Padding="0"
                                        ItemsSource="{Binding Options}">
                                        <ContextMenu.Template>
                                            <ControlTemplate TargetType="{x:Type ContextMenu}">
                                                <Border
                                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <ScrollViewer
                                                        Margin="2"
                                                        CanContentScroll="True"
                                                        Focusable="False"
                                                        PanningMode="VerticalOnly"
                                                        VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter VerticalAlignment="Top" />
                                                    </ScrollViewer>
                                                </Border>
                                            </ControlTemplate>
                                        </ContextMenu.Template>

                                        <ContextMenu.ItemContainerStyle>
                                            <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                                <Setter Property="Command" Value="{Binding DataContext.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                                <Setter Property="Header" Value="{Binding}" />
                                                <Setter Property="Padding" Value="8,6" />
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                        </StackPanel>
                    </DataTemplate>

                </ItemsControl.Resources>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
