<dialogs:BaseDialog x:Class="StreamTabula.Features.Decks.Views.Components.PropertyEditor.ImageLibraryDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:StreamTabula.Components.Dialogs"
                    xmlns:controls="clr-namespace:StreamTabula.Components.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    Width="1250"
                    MinWidth="800"
                    MaxWidth="4000"
                    Height="600"
                    MinHeight="600"
                    MaxHeight="700">

    <dialogs:BaseDialogContent Title="Image Library"
                               ButtonsPadding="0"
                               ContentPadding="0">
        
        <dialogs:BaseDialogContent.DialogContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:Button Grid.Row="0"
                           Content="Choose Custom Image..."
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Click="OnChooseCustomImageClick"
                           HorizontalAlignment="Left"
                           Margin="15, 15, 15, 0"
                           Appearance="Primary" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox Margin="15" ItemsSource="{Binding SystemImages, RelativeSource={RelativeSource AncestorType=Window}}"
                             SelectedItem="{Binding SelectedImage, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="0" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="100"
                                      Margin="4"
                                      Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Width="100"
                                            Height="100"
                                            CornerRadius="8"
                                            Background="#2B2B2B"
                                            BorderBrush="#555"
                                            BorderThickness="3"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">

                                        <controls:ClippingBorder ClipToBounds="True"
                                                                 CornerRadius="6">
                                            <Image Source="{Binding FullPath}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </controls:ClippingBorder>
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding FileName}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="11"
                                               Margin="2,4,2,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </dialogs:BaseDialogContent.DialogContent>
    </dialogs:BaseDialogContent>

</dialogs:BaseDialog>
