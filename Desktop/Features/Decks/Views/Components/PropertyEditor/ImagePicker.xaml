<UserControl
    x:Class="StreamTabula.Features.Decks.Views.Components.PropertyEditor.ImagePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StreamTabula.Components.Controls">

    <Grid
        Width="80"
        Height="80"
        Background="Transparent"
        Cursor="Hand"
        MouseLeftButtonDown="OnPickerClicked">
        <Rectangle
            RadiusX="8"
            RadiusY="8"
            Stroke="#888"
            StrokeDashArray="3 3"
            StrokeDashCap="Round"
            StrokeThickness="2" />

        <controls:FluentIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="24"
            Foreground="#888"
            IconType="Photo">
            <controls:FluentIcon.Style>
                <Style TargetType="controls:FluentIcon">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:FluentIcon.Style>
        </controls:FluentIcon>

        <controls:ClippingBorder
            Margin="3"
            ClipToBounds="True"
            CornerRadius="6">
            <Image Source="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </controls:ClippingBorder>

    </Grid>
</UserControl>
