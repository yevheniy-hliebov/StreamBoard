<UserControl x:Class="StreamTabula.Features.Decks.Views.Components.PropertyEditor.ImagePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:StreamTabula.Controls.Layout"
             xmlns:icons="clr-namespace:StreamTabula.Controls.Icons">

    <Grid Width="80"
          Height="80"
          Background="Transparent"
          Cursor="Hand"
          MouseLeftButtonDown="OnPickerClicked">

        <Rectangle RadiusX="8"
                   RadiusY="8"
                   Stroke="#888"
                   StrokeDashArray="3 3"
                   StrokeDashCap="Round"
                   StrokeThickness="2" />

        <icons:FluentIcon HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontSize="24"
                          Foreground="#888"
                          IconType="Photo">
            <icons:FluentIcon.Style>
                <Style TargetType="icons:FluentIcon">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="{x:Null}">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </icons:FluentIcon.Style>
        </icons:FluentIcon>

        <icons:FluentIcon Margin="3,0,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontSize="24"
                          Foreground="#FFA500"
                          IconType="Warning"
                          ToolTip="The image at the specified path was not found or has been deleted.">
            <icons:FluentIcon.Style>
                <Style TargetType="icons:FluentIcon">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsImageMissing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </icons:FluentIcon.Style>
        </icons:FluentIcon>

        <layout:ClippingBorder Margin="3"
                                 ClipToBounds="True"
                                 CornerRadius="6">
            <Image Source="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                   Stretch="UniformToFill">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsImageMissing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </layout:ClippingBorder>

    </Grid>
</UserControl>