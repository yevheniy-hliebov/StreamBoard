<UserControl
    x:Class="StreamBoard.Features.Decks.Views.Components.DeckProfile.DeckPageItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root">

    <Grid>
        <TextBlock
            x:Name="TitleLabel"
            VerticalAlignment="Center"
            Text="{Binding Title, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing, ElementName=Root}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ui:TextBox
            x:Name="EditBox"
            MinHeight="0"
            Padding="2,0"
            VerticalAlignment="Center"
            Text="{Binding Title, ElementName=Root, UpdateSourceTrigger=PropertyChanged}">
            <ui:TextBox.Style>
                <Style BasedOn="{StaticResource {x:Type ui:TextBox}}" TargetType="ui:TextBox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:TextBox.Style>
        </ui:TextBox>
    </Grid>
</UserControl>
