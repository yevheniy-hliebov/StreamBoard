<UserControl
    x:Class="StreamTabula.Features.Decks.Views.Components.Canvas.GridCanvasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StreamTabula.Components.Controls"
    xmlns:dd="clr-namespace:CustomDragDropLib;assembly=CustomDragDropLib"
    xmlns:local="clr-namespace:StreamTabula.Features.Decks.Views.Components.Canvas"
    xmlns:models="clr-namespace:StreamTabula.Features.Decks.Models"
    x:Name="Root">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="X" Command="{Binding CutCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <DataTemplate x:Key="EditorModeTemplate">
            <dd:DropWrapper
                Margin="0"
                Padding="2"
                DragOverBackground="Transparent"
                DragOverBorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                DropCommand="{Binding ReceiveDropCommand}">

                <dd:DraggableWrapper Payload="{Binding}">
                    <local:DeckButtonSlotView
                        Margin="4"
                        ButtonBackground="{Binding Config.BackgroundColor, FallbackValue=#2B2B2B}"
                        ButtonIndex="{Binding Index}"
                        ButtonName="{Binding Config.Name}"
                        Command="{Binding DataContext.ClickButtonCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        ImagePath="{Binding Config.ImagePath}"
                        IsSelected="{Binding IsSelected}" />
                </dd:DraggableWrapper>

            </dd:DropWrapper>
        </DataTemplate>

        <DataTemplate x:Key="ClickModeTemplate">
            <local:DeckButtonSlotView
                Margin="6" ButtonBackground="{Binding Config.BackgroundColor, FallbackValue=#2B2B2B}"
                ButtonIndex="{Binding Index}"
                ButtonName="{Binding Config.Name}"
                Command="{Binding DataContext.ClickButtonCommand, ElementName=Root}"
                CommandParameter="{Binding}"
                Cursor="Hand"
                ImagePath="{Binding Config.ImagePath}"
                IsSelected="{Binding IsSelected}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Canvas
            x:Name="Viewport"
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            ClipToBounds="True">

            <Border
                x:Name="DeckSurface"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                BorderThickness="1"
                CornerRadius="8"
                RenderTransformOrigin="0,0">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="PanTransform" />
                </Border.RenderTransform>


                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CanvasConfig.SelectedGrid.Columns}" Rows="{Binding CanvasConfig.SelectedGrid.Rows}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource EditorModeTemplate}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsClickMode, ElementName=Root}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ClickModeTemplate}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </Border>
        </Canvas>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <ComboBox
                Grid.Column="0"
                Width="110"
                Margin="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                DisplayMemberPath="Name"
                ItemsSource="{Binding CanvasConfig.Grids}"
                SelectedItem="{Binding CanvasConfig.SelectedGrid, Mode=TwoWay}" />

            <controls:LabeledToggle
                Grid.Column="2"
                Margin="12"
                VerticalAlignment="Center"
                IsChecked="{Binding IsClickMode}"
                ToggleOffText="Editor Mode"
                ToggleOnText="Click Mode" />
        </Grid>

    </Grid>
</UserControl>