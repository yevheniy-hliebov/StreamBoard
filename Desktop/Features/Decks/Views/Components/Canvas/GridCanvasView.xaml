<UserControl x:Class="StreamTabula.Features.Decks.Views.Components.Canvas.GridCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inputs="clr-namespace:StreamTabula.Controls.Inputs"
             xmlns:dd="clr-namespace:CustomDragDropLib;assembly=CustomDragDropLib"
             xmlns:layout="clr-namespace:StreamTabula.Controls.Layout"
             xmlns:local="clr-namespace:StreamTabula.Features.Decks.Views.Components.Canvas"
             x:Name="Root">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl"
                    Key="C"
                    Command="{Binding CopyCommand, ElementName=Root}" />
        <KeyBinding Modifiers="Ctrl"
                    Key="V"
                    Command="{Binding PasteCommand, ElementName=Root}" />
        <KeyBinding Modifiers="Ctrl"
                    Key="X"
                    Command="{Binding CutCommand, ElementName=Root}" />
        <KeyBinding Key="Delete"
                    Command="{Binding DeleteCommand, ElementName=Root}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <DataTemplate x:Key="EditorModeTemplate">
            <dd:DropWrapper Margin="0"
                            Padding="2"
                            DragOverBackground="Transparent"
                            DragOverBorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            DropCommand="{Binding ReceiveDropCommand}">

                <dd:DraggableWrapper Payload="{Binding}">
                    <local:DeckButtonSlotView Margin="4"
                                              Config="{Binding Config}"
                                              ButtonIndex="{Binding Index}"
                                              IsSelected="{Binding IsSelected}"
                                              Command="{Binding ClickButtonCommand, RelativeSource={RelativeSource AncestorType=local:GridCanvasView}}"
                                              CommandParameter="{Binding}"
                                              Cursor="Hand" />
                </dd:DraggableWrapper>

            </dd:DropWrapper>
        </DataTemplate>

        <DataTemplate x:Key="ClickModeTemplate">
            <local:DeckButtonSlotView Margin="6"
                                      Config="{Binding Config}"
                                      ButtonIndex="{Binding Index}"
                                      IsSelected="{Binding IsSelected}"
                                      Command="{Binding ClickButtonCommand, RelativeSource={RelativeSource AncestorType=local:GridCanvasView}}"
                                      CommandParameter="{Binding}"
                                      Cursor="Hand" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <layout:PannableWorkspace Grid.Row="0"
                                  Grid.RowSpan="2">
            <Border Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <ItemsControl ItemsSource="{Binding Buttons, RelativeSource={RelativeSource AncestorType=local:GridCanvasView}}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CanvasConfig.SelectedGrid.Columns, RelativeSource={RelativeSource AncestorType=local:GridCanvasView}}"
                                         Rows="{Binding CanvasConfig.SelectedGrid.Rows, RelativeSource={RelativeSource AncestorType=local:GridCanvasView}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource EditorModeTemplate}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClickMode, RelativeSource={RelativeSource AncestorType=local:GridCanvasView}}"
                                                         Value="True">
                                                <Setter Property="ContentTemplate"
                                                        Value="{StaticResource ClickModeTemplate}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </Border>
        </layout:PannableWorkspace>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Width="110"
                      Margin="12"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding CanvasConfig.Grids, ElementName=Root}"
                      SelectedItem="{Binding CanvasConfig.SelectedGrid, ElementName=Root, Mode=TwoWay}"
                      IsEnabled="{Binding IsEditorMode, ElementName=Root}" />

            <inputs:LabeledToggle Grid.Column="2"
                                  Margin="12"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsClickMode, ElementName=Root}"
                                  ToggleOffText="Editor Mode"
                                  ToggleOnText="Click Mode" />
        </Grid>
    </Grid>
</UserControl>