<UserControl x:Class="StreamTabula.Features.Decks.Views.Components.Canvas.DeckButtonSlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:StreamTabula.Controls.Layout"
             xmlns:icons="clr-namespace:StreamTabula.Controls.Icons"
             Width="65"
             Height="65"
             ToolTipService.Placement="Center"
             ToolTipService.VerticalOffset="35"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             x:Name="Root">

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="ToolTip"
                    Value="{Binding Config.Name, ElementName=Root}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Config.HasName, ElementName=Root}"
                             Value="False">
                    <Setter Property="ToolTip"
                            Value="{Binding ButtonIndex, ElementName=Root}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Config, ElementName=Root}"
                             Value="{x:Null}">
                    <Setter Property="ToolTip"
                            Value="{Binding ButtonIndex, ElementName=Root}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <Grid.InputBindings>
            <MouseBinding Command="{Binding Command, ElementName=Root}"
                          CommandParameter="{Binding CommandParameter, ElementName=Root}"
                          MouseAction="LeftClick" />
        </Grid.InputBindings>

        <layout:SmoothBorder CornerRadius="12"
                             BorderThickness="4"
                             Background="{Binding Config.BackgroundColor, ElementName=Root, FallbackValue='#2B2B2B'}">

            <layout:SmoothBorder.Style>
                <Style TargetType="layout:SmoothBorder">
                    <Setter Property="BorderBrush"
                            Value="#555" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, ElementName=Root}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource SystemFillColorAttentionBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </layout:SmoothBorder.Style>

            <layout:SmoothBorder.OverlayBrush>
                <ImageBrush Stretch="UniformToFill"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            ImageSource="{Binding Config.ImagePath, ElementName=Root}" />
            </layout:SmoothBorder.OverlayBrush>

            <layout:SmoothBorder.InnerContent>
                <icons:FluentIcon HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FontSize="18"
                                  Foreground="#FFA500"
                                  IconType="Warning"
                                  ToolTip="The image at the specified path was not found or has been deleted.">
                    <icons:FluentIcon.Style>
                        <Style TargetType="icons:FluentIcon">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImageMissing, ElementName=Root}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </icons:FluentIcon.Style>
                </icons:FluentIcon>
            </layout:SmoothBorder.InnerContent>

        </layout:SmoothBorder>
    </Grid>

</UserControl>