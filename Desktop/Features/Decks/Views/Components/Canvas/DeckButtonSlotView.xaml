<UserControl x:Class="StreamTabula.Features.Decks.Views.Components.Canvas.DeckButtonSlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:StreamTabula.Controls.Icons"
             Width="65"
             Height="65"
             ToolTipService.Placement="Center"
             ToolTipService.VerticalOffset="35"
             x:Name="Root">

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="ToolTip"
                    Value="{Binding Config.Name, ElementName=Root}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Config.HasName, ElementName=Root}"
                             Value="False">
                    <Setter Property="ToolTip"
                            Value="{Binding ButtonIndex, ElementName=Root}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Config, ElementName=Root}"
                             Value="{x:Null}">
                    <Setter Property="ToolTip"
                            Value="{Binding ButtonIndex, ElementName=Root}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <Grid.InputBindings>
            <MouseBinding Command="{Binding Command, ElementName=Root}"
                          CommandParameter="{Binding CommandParameter, ElementName=Root}"
                          MouseAction="LeftClick" />
        </Grid.InputBindings>

        <Border CornerRadius="12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"
                            Value="#555" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource SystemFillColorAttentionBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Border Margin="4"
                CornerRadius="8"
                Background="{Binding Config.BackgroundColor, ElementName=Root, FallbackValue='#2B2B2B'}" />

        <Border Margin="4"
                CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Config.ImagePath, ElementName=Root}"
                                     Value="{x:Null}">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Config.ImagePath, ElementName=Root}"
                                     Value="">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsImageMissing, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Background>
                <ImageBrush Stretch="UniformToFill"
                            ImageSource="{Binding Config.ImagePath, ElementName=Root}" />
            </Border.Background>
        </Border>

        <icons:FluentIcon HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontSize="18"
                          Foreground="#FFA500"
                          IconType="Warning"
                          ToolTip="The image at the specified path was not found or has been deleted.">
            <icons:FluentIcon.Style>
                <Style TargetType="icons:FluentIcon">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsImageMissing, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </icons:FluentIcon.Style>
        </icons:FluentIcon>
    </Grid>

</UserControl>