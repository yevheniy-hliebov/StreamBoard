<Page x:Class="StreamTabula.Features.Integrations.OBS.Views.Pages.OBSSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:cards="clr-namespace:StreamTabula.Controls.Cards"
      xmlns:inputs="clr-namespace:StreamTabula.Controls.Inputs"
      xmlns:ic="clr-namespace:StreamTabula.Features.Integrations.Common.Views.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ObsSettingsPage">

    <StackPanel Margin="16">
        <StackPanel.Resources>
            <Style TargetType="cards:CardControl">
                <Setter Property="Margin"
                        Value="0,0,0,12" />
            </Style>
        </StackPanel.Resources>

        <ic:IntegrationPageHeader Title="OBS Studio"
                                  IconType="Obs"
                                  Subtitle="Supported since version v5.0.0" />

        <cards:CardControl Title="Connection Status"
                           Description="{Binding ConnectionStateString}">
            <cards:CardControl.ActionContent>
                <ui:Button Command="{Binding ToggleConnectionCommand}"
                           Content="{Binding ActionButtonText}">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}"
                               TargetType="ui:Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProcessing}"
                                             Value="True">
                                    <Setter Property="IsEnabled"
                                            Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardExpander Title="Connection Settings"
                            Margin="0,0,0,12"
                            Description="Configure the WebSocket server address, port, and password to communicate with OBS">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,8"
                               Text="Host IP" />
                    <ui:TextBox IsEnabled="{Binding CanEditSettings}"
                                Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="1">
                    <TextBlock Margin="0,0,0,8"
                               Text="Port" />
                    <ui:TextBox IsEnabled="{Binding CanEditSettings}"
                                Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,0">
                    <TextBlock Margin="0,0,0,8"
                               Text="Password" />
                    <ui:PasswordBox IsEnabled="{Binding CanEditSettings}"
                                    Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PasswordChar="*" />
                </StackPanel>
            </Grid>
        </cards:CardExpander>

        <cards:CardControl Title="Auto Connect on Startup"
                           Description="Automatically establish a connection to OBS Studio as soon as the app launches">
            <cards:CardControl.ActionContent>
                <inputs:LabeledToggle IsChecked="{Binding AutoConnectOnStartup, Mode=TwoWay}"
                                        IsEnabled="{Binding CanEditSettings}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardControl Title="Auto Reconnect"
                           Description="Automatically attempt to restore the connection if it is unexpectedly lost">
            <cards:CardControl.ActionContent>
                <inputs:LabeledToggle IsChecked="{Binding AutoReconnect, Mode=TwoWay}"
                                        IsEnabled="{Binding CanEditSettings}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardControl Title="Reconnect Delay"
                           Description="Set the delay between automatic reconnection attempts in seconds">
            <cards:CardControl.ActionContent>
                <ui:NumberBox Width="110"
                              VerticalAlignment="Center"
                              ClearButtonEnabled="False"
                              IsEnabled="{Binding CanEditSettings}"
                              Minimum="15"
                              PlaceholderText="Enter delay..."
                              SmallChange="10"
                              Value="{Binding ReconnectDelay, UpdateSourceTrigger=PropertyChanged}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

        <cards:CardControl Title="Keep Alive Interval"
                           Description="Set the interval for sending ping packets to maintain the connection in seconds">
            <cards:CardControl.ActionContent>
                <ui:NumberBox Width="110"
                              VerticalAlignment="Center"
                              ClearButtonEnabled="False"
                              IsEnabled="{Binding CanEditSettings}"
                              Minimum="30"
                              PlaceholderText="Enter interval..."
                              SmallChange="10"
                              Value="{Binding KeepAliveIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>

    </StackPanel>
</Page>
