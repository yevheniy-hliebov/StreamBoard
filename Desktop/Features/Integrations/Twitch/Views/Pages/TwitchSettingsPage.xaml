<Page
    x:Class="StreamBoard.Features.Integrations.Twitch.Views.Pages.TwitchSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:StreamBoard.Features.Integrations.Twitch.Views.Components"
    xmlns:controls="clr-namespace:StreamBoard.Components.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <StackPanel Margin="16">
        <controls:PageTitle Text="Twitch" />

        <components:TwitchAccountCard
            Margin="0,0,0,12"
            AccountRole="{Binding BroadcasterAccount.AccountRole}"
            IsAuth="{Binding BroadcasterAccount.IsAuth}"
            LoginCommand="{Binding BroadcasterAccount.LoginCommand}"
            LogoutCommand="{Binding BroadcasterAccount.LogoutCommand}"
            User="{Binding BroadcasterAccount.User}" />

        <components:TwitchAccountCard
            Margin="0,0,0,12"
            AccountRole="{Binding BotAccount.AccountRole}"
            IsAuth="{Binding BotAccount.IsAuth}"
            LoginCommand="{Binding BotAccount.LoginCommand}"
            LogoutCommand="{Binding BotAccount.LogoutCommand}"
            User="{Binding BotAccount.User}" />
    </StackPanel>
</Page>
