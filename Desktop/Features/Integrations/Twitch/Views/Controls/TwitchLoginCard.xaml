<UserControl x:Class="StreamTabula.Features.Integrations.Twitch.Views.Controls.TwitchLoginCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:StreamTabula.Controls.Cards"
             xmlns:local="clr-namespace:StreamTabula.Features.Integrations.Twitch.Views.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <Grid DataContext="{Binding ElementName=Root}">
        <cards:CardControl Title="{Binding AccountRole}"
                           Description="Connect your Twitch account to access integrations.">
            <cards:CardControl.ActionContent>
                <ui:Button Command="{Binding LoginCommand}"
                           Content="Login" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>
    </Grid>

</UserControl>
