<UserControl
    x:Class="StreamBoard.Features.Integrations.Twitch.Views.Components.TwitchProfileCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:StreamBoard.Helpers"
    xmlns:local="clr-namespace:StreamBoard.Features.Integrations.Twitch.Views.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root">

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding User, ElementName=Root}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <UserControl.Resources>
        <helpers:FastAvatarConverter x:Key="FastAvatar" />
    </UserControl.Resources>

    <Grid DataContext="{Binding ElementName=Root}">
        <ui:CardControl>
            <ui:CardControl.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        Width="48"
                        Height="48"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource SystemControlBackgroundAltMediumBrush}" />

                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding User.ProfileImageUrl, Converter={StaticResource FastAvatar}, IsAsync=True}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding User.Login}" />

                        <StackPanel Orientation="Horizontal">
                            <ui:Badge Margin="0,0,8,0" Appearance="Info">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}"
                                    Text="{Binding AccountRole}" />
                            </ui:Badge>

                            <ui:Badge Appearance="Success">
                                <ui:Badge.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Badge}}" TargetType="ui:Badge">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding User.BroadcasterType}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding User.BroadcasterType}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Badge.Style>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}"
                                    Text="{Binding User.BroadcasterType}" />
                            </ui:Badge>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:CardControl.Header>

            <ui:Button Command="{Binding LogoutCommand}" Content="Logout" />
        </ui:CardControl>
    </Grid>
</UserControl>
