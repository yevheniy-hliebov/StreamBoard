<UserControl
    x:Class="StreamBoard.Features.Integrations.Twitch.Views.Components.TwitchLoginCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="clr-namespace:StreamBoard.Components.Cards"
    xmlns:controls="clr-namespace:StreamBoard.Components.Controls"
    xmlns:local="clr-namespace:StreamBoard.Features.Integrations.Twitch.Views.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root">

    <Grid DataContext="{Binding ElementName=Root}">
        <cards:CardControl Title="{Binding AccountRole}" Description="Connect your Twitch account to access integrations.">
            <cards:CardControl.ActionContent>
                <ui:Button Command="{Binding LoginCommand}" Content="Login" />
            </cards:CardControl.ActionContent>
        </cards:CardControl>
    </Grid>

</UserControl>
