<UserControl
    x:Class="StreamBoard.Features.Integrations.Common.Views.Components.ConnectionStateMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="RootMenu">

    <ui:DropDownButton x:Name="ParentButton">
        <ui:DropDownButton.Content>
            <StackPanel Orientation="Horizontal">
                <Border
                    Width="12"
                    Height="12"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Background="{Binding SummaryColor, ElementName=RootMenu}"
                    CornerRadius="5" />
                <TextBlock VerticalAlignment="Center" Text="Integration Connections" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding SummaryText, ElementName=RootMenu}" />
            </StackPanel>
        </ui:DropDownButton.Content>

        <ui:DropDownButton.Flyout>
            <ContextMenu x:Name="MainContextMenu" Placement="Bottom" />
        </ui:DropDownButton.Flyout>
    </ui:DropDownButton>
</UserControl>
