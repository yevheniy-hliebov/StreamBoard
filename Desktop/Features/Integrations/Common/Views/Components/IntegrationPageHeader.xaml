<UserControl
    x:Class="StreamTabula.Features.Integrations.Common.Views.Components.IntegrationPageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StreamTabula.Components.Controls"
    xmlns:local="clr-namespace:StreamTabula.Features.Integrations.Common.Views.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root">

    <StackPanel Margin="0,0,0,12" DataContext="{Binding ElementName=Root}">
        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <local:IntegrationIcon
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                IconType="{Binding IconType}"
                Size="25" />

            <controls:PageTitle
                Margin="0,0,0,-12"
                VerticalAlignment="Center"
                Text="{Binding Title}" />
        </StackPanel>

        <TextBlock
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            LineHeight="20"
            Text="{Binding Subtitle}" />
    </StackPanel>
</UserControl>
