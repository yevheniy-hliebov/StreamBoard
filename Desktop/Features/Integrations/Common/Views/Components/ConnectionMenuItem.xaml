<UserControl
    x:Class="StreamTabula.Features.Integrations.Common.Views.Components.ConnectionMenuItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StreamTabula.Components.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    ToolTip="{Binding StateText, ElementName=Root}">

    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Width="15"
            Height="15"
            Margin="-5,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{Binding StateColor, ElementName=Root}"
            CornerRadius="15" />

        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            FontSize="14"
            Text="{Binding Title, ElementName=Root}" />

        <controls:FluentIcon
            Grid.Column="2"
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            IconType="ChevronRight" />
    </Grid>
</UserControl>
