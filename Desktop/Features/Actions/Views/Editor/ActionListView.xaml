<UserControl x:Class="StreamTabula.Features.Actions.Views.Editor.ActionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cdd="clr-namespace:CustomDragDropLib;assembly=CustomDragDropLib"
             xmlns:layout="clr-namespace:StreamTabula.Controls.Layout"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
             xmlns:local="clr-namespace:StreamTabula.Features.Actions.Views.Editor"
             xmlns:reorder="clr-namespace:StreamTabula.Controls.Lists"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <cdd:DropWrapper Margin="0"
                     Padding="2"
                     DragOverBackground="Transparent"
                     DragOverBorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                     DataContext="{Binding ViewModel, ElementName=Root}"
                     DropCommand="{Binding ReceiveActionDropCommand}">

        <layout:ConstrainedScrollBorder>

            <reorder:ReorderListView SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                     HorizontalContentAlignment="Stretch"
                                     dd:DragDrop.DropHandler="{Binding}"
                                     dd:DragDrop.IsDragSource="True"
                                     dd:DragDrop.IsDropTarget="True"
                                     ItemsSource="{Binding Actions}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <reorder:ReorderListView.InputBindings>
                    <KeyBinding Modifiers="Ctrl"
                                Key="C"
                                Command="{Binding CopyActionCommand}"
                                CommandParameter="{Binding SelectedAction.Id}" />
                    <KeyBinding Modifiers="Ctrl"
                                Key="X"
                                Command="{Binding CutActionCommand}"
                                CommandParameter="{Binding SelectedAction.Id}" />
                    <KeyBinding Modifiers="Ctrl"
                                Key="D"
                                Command="{Binding DuplicateActionCommand}"
                                CommandParameter="{Binding SelectedAction.Id}" />
                    <KeyBinding Key="Delete"
                                Command="{Binding DeleteActionCommand}"
                                CommandParameter="{Binding SelectedAction.Id}" />
                    <KeyBinding Modifiers="Ctrl"
                                Key="V"
                                Command="{Binding PasteActionCommand}" />
                </reorder:ReorderListView.InputBindings>

                <reorder:ReorderListView.ItemTemplate>
                    <DataTemplate>
                        <reorder:ReorderListItemWrapper ShowDragHandle="True"
                                                        UseDragHandle="True">

                            <local:ActionListItem ActionId="{Binding Id}"
                                                  Icon="{Binding Metadata.Icon}"
                                                  Text="{Binding FullLabel}"
                                                  DeleteCommand="{Binding DataContext.DeleteActionCommand, RelativeSource={RelativeSource AncestorType=reorder:ReorderListView}}"
                                                  EditCommand="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=reorder:ReorderListView}}" />

                        </reorder:ReorderListItemWrapper>
                    </DataTemplate>
                </reorder:ReorderListView.ItemTemplate>
            </reorder:ReorderListView>

        </layout:ConstrainedScrollBorder>
    </cdd:DropWrapper>
</UserControl>