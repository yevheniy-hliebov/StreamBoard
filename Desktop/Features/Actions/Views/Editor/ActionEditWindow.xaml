<ui:FluentWindow x:Class="StreamTabula.Features.Actions.Views.Editor.ActionEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:StreamTabula.Features.Actions.Views.Editor"
                 xmlns:shell="clr-namespace:StreamTabula.Shell"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="400"
                 MinHeight="200"
                 MaxWidth="400"
                 MaxHeight="500"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 SizeToContent="Height"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <shell:TitleBar Grid.Row="0"
                        Title="{Binding EditingActionCopy.Metadata.DialogTitle, FallbackValue='Edit Action'}"
                        ShowAppIcon="False"
                        ShowMinimize="False"
                        ShowMaximize="False" />

        <Grid Grid.Row="1"
              Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:ActionPropertiesView Grid.Row="0"
                                        DataContext="{Binding}" />

            <StackPanel Grid.Row="1"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0"
                           IsCancel="True"
                           Click="Cancel_Click"
                           Content="Cancel" />

                <ui:Button Appearance="Primary"
                           IsDefault="True"
                           Click="Save_Click"
                           Content="Save" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
