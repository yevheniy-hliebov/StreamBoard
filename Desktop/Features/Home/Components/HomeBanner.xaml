<UserControl
    x:Class="StreamTabula.Features.Home.Components.HomeBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StreamTabula.Features.Home.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="150"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Border
        Height="112"
        CornerRadius="8"
        SnapsToDevicePixels="True">
        <Border.Background>
            <ImageBrush ImageSource="pack://application:,,,/StreamTabula;component/Assets/Images/banner_background.png" Stretch="UniformToFill" />
        </Border.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image
                Grid.Column="0"
                Width="80"
                Height="80"
                Margin="16,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="pack://application:,,,/StreamTabula;component/Assets/Images/logo.png" />

            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center">

                <TextBlock
                    Margin="0,0,0,0"
                    FontSize="40"
                    FontWeight="SemiBold"
                    Foreground="White"
                    LineHeight="52"
                    Text="{Binding AppName}" />

                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    LineHeight="20"
                    Text="{Binding CurrentVersion}" />
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                Margin="0,0,16,16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="12"
                Foreground="White"
                Opacity="0.7"
                Text="Created by inkluznyk (github.com/yevheniy-hliebov/StreamTabula)">
                <TextBlock.Effect>
                    <DropShadowEffect
                        BlurRadius="4"
                        Direction="315"
                        Opacity="0.63"
                        ShadowDepth="2.8"
                        Color="Black" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
