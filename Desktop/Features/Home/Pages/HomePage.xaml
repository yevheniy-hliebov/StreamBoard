<Page
    x:Class="StreamBoard.Features.Home.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="clr-namespace:StreamBoard.Components.Cards"
    xmlns:components="clr-namespace:StreamBoard.Features.Home.Components"
    xmlns:controls="clr-namespace:StreamBoard.Components.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="clr-namespace:StreamBoard.Features.Integrations.Common.Views.Components"
    xmlns:local="clr-namespace:StreamBoard.Features.Home.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="HomePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <StackPanel Margin="16">
        <components:HomeBanner Margin="0,0,0,12" />

        <UniformGrid Margin="-5,0,-5,0" Columns="4">
            <UniformGrid.Resources>
                <Style TargetType="cards:NavigationCard">
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnCardClick" />
                </Style>
            </UniformGrid.Resources>

            <cards:NavigationCard
                Title="Grid Deck"
                Description="Configure touch layouts. Manage virtual buttons, customize grids and view action assignments for your devices."
                IconPosition="Top">
                <cards:NavigationCard.Icon>
                    <controls:FluentIcon FontSize="28" IconType="Grid" />
                </cards:NavigationCard.Icon>
            </cards:NavigationCard>

            <cards:NavigationCard
                Title="Keyboard Deck"
                Description="Configure input mappings. Manage physical keys, customize bindings and view action assignments for your keyboards."
                IconPosition="Top">
                <cards:NavigationCard.Icon>
                    <controls:FluentIcon FontSize="28" IconType="Keyboard" />
                </cards:NavigationCard.Icon>
            </cards:NavigationCard>

            <cards:NavigationCard
                Title="OBS Studio"
                Description="Configure WebSocket connection settings with OBS and view current status."
                IconPosition="Top">
                <cards:NavigationCard.Icon>
                    <ic:IntegrationIcon IconType="Obs" Size="28" />
                </cards:NavigationCard.Icon>
            </cards:NavigationCard>

            <cards:NavigationCard
                Title="Twitch"
                Description="Manage account authentications and view connection status."
                IconPosition="Top">
                <cards:NavigationCard.Icon>
                    <ic:IntegrationIcon IconType="Twitch" Size="28" />
                </cards:NavigationCard.Icon>
            </cards:NavigationCard>

        </UniformGrid>
    </StackPanel>
</Page>
