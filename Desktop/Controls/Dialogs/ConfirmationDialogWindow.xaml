<dialogs:BaseDialog x:Class="StreamTabula.Controls.Dialogs.ConfirmationDialogWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:StreamTabula.Controls.Dialogs"
                    xmlns:icons="clr-namespace:StreamTabula.Controls.Icons"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    Height="230"
                    MinHeight="230"
                    MaxHeight="300">

    <dialogs:BaseDialogContent Title="{Binding Title}">
        <dialogs:BaseDialogContent.DialogContent>
            <StackPanel>
                <icons:FluentIcon Margin="0,0,0,16"
                                     HorizontalAlignment="Center"
                                     FontSize="42"
                                     Foreground="#FFA500"
                                     IconType="Warning" />

                <TextBlock Margin="0,0,0,24"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Text="{Binding Message}" />
            </StackPanel>
        </dialogs:BaseDialogContent.DialogContent>

        <dialogs:BaseDialogContent.Buttons>
            <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0"
                           Width="100"
                           Appearance="Primary"
                           IsDefault="True"
                           Click="Submit"
                           Content="OK" />
                <ui:Button Width="100"
                           IsCancel="True"
                           Click="Cancel"
                           Content="Cancel" />
            </StackPanel>
        </dialogs:BaseDialogContent.Buttons>
    </dialogs:BaseDialogContent>

</dialogs:BaseDialog>
