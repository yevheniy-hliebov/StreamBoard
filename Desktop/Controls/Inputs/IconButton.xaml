<UserControl x:Class="StreamTabula.Controls.Inputs.IconButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:icons="clr-namespace:StreamTabula.Controls.Icons"
             x:Name="Root">
    
    <ui:Button Appearance="Transparent"
           Padding="4"
           BorderThickness="0"
           Background="Transparent"
           ToolTip="{Binding TooltipText, ElementName=Root}"
           Command="{Binding Command, ElementName=Root}"
           CommandParameter="{Binding CommandParameter, ElementName=Root}">
        <icons:FluentIcon IconType="{Binding IconType, ElementName=Root}" FontSize="14" />
    </ui:Button>
</UserControl>
