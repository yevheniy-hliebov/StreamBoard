<UserControl x:Class="StreamTabula.Controls.Inputs.ImagePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:StreamTabula.Controls.Layout"
             xmlns:icons="clr-namespace:StreamTabula.Controls.Icons"
             x:Name="Root">

    <Button Click="OnPickerClicked"
            Cursor="Hand"
            Background="Transparent"
            Width="80"
            Height="80">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid Background="{TemplateBinding Background}">
                    <Rectangle x:Name="BorderRect"
                               RadiusX="8"
                               RadiusY="8"
                               Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                               StrokeDashArray="3 3"
                               StrokeDashCap="Round"
                               StrokeThickness="2" />

                    <icons:FluentIcon x:Name="PlaceholderIcon"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontSize="24"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      IconType="Photo"
                                      Visibility="Collapsed" />

                    <icons:FluentIcon x:Name="ErrorIcon"
                                      Margin="3,0,0,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontSize="24"
                                      Foreground="#FFA500"
                                      IconType="Warning"
                                      ToolTip="The image at the specified path was not found or has been deleted."
                                      Visibility="Collapsed" />

                    <Border x:Name="ImageContainer"
                            Margin="3"
                            CornerRadius="6"
                            Visibility="Visible">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ImagePath, ElementName=Root, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                        Stretch="UniformToFill"
                                        AlignmentX="Center"
                                        AlignmentY="Center" />
                        </Border.Background>
                    </Border>
                </Grid>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter TargetName="BorderRect"
                                Property="Stroke"
                                Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter TargetName="PlaceholderIcon"
                                Property="Foreground"
                                Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>

                    <DataTrigger Binding="{Binding IsImageMissing, ElementName=Root}"
                                 Value="True">
                        <Setter TargetName="ErrorIcon"
                                Property="Visibility"
                                Value="Visible" />
                        <Setter TargetName="ImageContainer"
                                Property="Visibility"
                                Value="Collapsed" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding ImagePath, ElementName=Root}"
                                 Value="{x:Null}">
                        <Setter TargetName="PlaceholderIcon"
                                Property="Visibility"
                                Value="Visible" />
                        <Setter TargetName="ImageContainer"
                                Property="Visibility"
                                Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ImagePath, ElementName=Root}"
                                 Value="">
                        <Setter TargetName="PlaceholderIcon"
                                Property="Visibility"
                                Value="Visible" />
                        <Setter TargetName="ImageContainer"
                                Property="Visibility"
                                Value="Collapsed" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>