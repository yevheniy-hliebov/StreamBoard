<dialogs:BaseDialog x:Class="StreamTabula.Controls.ColorPicker.ColorPickerDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:StreamTabula.Controls.Dialogs"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:StreamTabula.Controls.ColorPicker"
                    Title="Select Color"
                    Height="420"
                    MinHeight="420"
                    MaxHeight="500">

    <dialogs:BaseDialogContent Title="Select Color">
        <dialogs:BaseDialogContent.DialogContent>
            <local:ColorPickerPanel Margin="0,8,0,0"
                                    SelectedColor="{Binding DialogSelectedColor, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />

        </dialogs:BaseDialogContent.DialogContent>

        <dialogs:BaseDialogContent.Buttons>
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0"
                           Width="90"
                           IsCancel="True"
                           Click="Cancel"
                           Content="Cancel" />
                <ui:Button Width="90"
                           Appearance="Primary"
                           IsDefault="True"
                           Click="Submit"
                           Content="Apply" />
            </StackPanel>
        </dialogs:BaseDialogContent.Buttons>
    </dialogs:BaseDialogContent>
</dialogs:BaseDialog>