<UserControl x:Class="StreamTabula.Controls.Layout.PannableWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Canvas x:Name="Viewport"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            ClipToBounds="True">

        <ContentPresenter x:Name="WorkspacePresenter"
                          Content="{Binding WorkspaceContent, ElementName=Root}"
                          RenderTransformOrigin="0,0">
            <ContentPresenter.RenderTransform>
                <TranslateTransform x:Name="PanTransform" />
            </ContentPresenter.RenderTransform>
        </ContentPresenter>

    </Canvas>
</UserControl>