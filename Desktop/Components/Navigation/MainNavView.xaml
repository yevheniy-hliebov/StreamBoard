<UserControl
    x:Class="StreamBoard.Components.Navigation.MainNavView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StreamBoard.Components.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:decks="clr-namespace:StreamBoard.Features.Decks.Views.Pages"
    xmlns:home="clr-namespace:StreamBoard.Features.Home.Pages"
    xmlns:local="clr-namespace:StreamBoard.Components.Navigation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:servers="clr-namespace:StreamBoard.Features.Servers.Pages"
    xmlns:settings="clr-namespace:StreamBoard.Features.Settings.Pages"
    xmlns:twitch="clr-namespace:StreamBoard.Features.Integrations.Twitch.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:Background="White"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ui:NavigationView
        x:Name="RootNavigation"
        FrameMargin="0"
        IsBackButtonVisible="Collapsed"
        IsFooterSeparatorVisible="False"
        IsPaneToggleVisible="True"
        IsTopSeparatorVisible="False"
        OpenPaneLength="200"
        PaneDisplayMode="Left">
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="Home" TargetPageType="{x:Type home:HomePage}">
                <ui:NavigationViewItem.Icon>
                    <controls:FluentIcon FontSize="16" IconType="Home" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItemSeparator />

            <ui:NavigationViewItem Content="Grid Deck" TargetPageType="{x:Type decks:GridDeckPage}">
                <ui:NavigationViewItem.Icon>
                    <controls:FluentIcon FontSize="16" IconType="Grid" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItemSeparator />

            <ui:NavigationViewItem Content="Twitch" TargetPageType="{x:Type twitch:TwitchSettingsPage}">
                <ui:NavigationViewItem.Icon>
                    <controls:FluentIcon FontSize="16" IconType="Grid" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItemSeparator />

            <ui:NavigationViewItem Content="Servers / Clients">
                <ui:NavigationViewItem.Icon>
                    <controls:FluentIcon FontSize="16" IconType="Devices" />
                </ui:NavigationViewItem.Icon>

                <ui:NavigationViewItem.MenuItems>
                    <ui:NavigationViewItem Content="HTTP Server" TargetPageType="{x:Type servers:HttpServerPage}">
                        <ui:NavigationViewItem.Icon>
                            <controls:FluentIcon FontSize="16" IconType="Network" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                </ui:NavigationViewItem.MenuItems>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.FooterMenuItems>
            <ui:NavigationViewItemSeparator />

            <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type settings:SettingsPage}">
                <ui:NavigationViewItem.Icon>
                    <controls:FluentIcon FontSize="16" IconType="Settings" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
</UserControl>
