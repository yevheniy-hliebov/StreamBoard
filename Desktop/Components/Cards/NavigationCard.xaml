<UserControl x:Class="StreamBoard.Components.Cards.NavigationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:StreamBoard.Components.Cards"
             x:Name="Root">

    <ui:CardAction VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   VerticalContentAlignment="Top"
                   Command="{Binding Command, ElementName=Root}"
                   IsChevronVisible="{Binding IsChevronVisible, ElementName=Root}">
        <Grid>
            <StackPanel x:Name="ContentPanel">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Orientation" Value="Vertical"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IconPosition, ElementName=Root}" Value="{x:Static local:IconPosition.Left}">
                                <Setter Property="Orientation" Value="Horizontal"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ContentControl Content="{Binding Icon, ElementName=Root}"
                                HorizontalAlignment="Left"
                                x:Name="IconContainer">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Width" Value="28"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Margin" Value="0,0,0,12"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IconPosition, ElementName=Root}" Value="{x:Static local:IconPosition.Left}">
                                    <Setter Property="Width" Value="28"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Margin" Value="0,0,12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <StackPanel x:Name="TextPanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IconPosition, ElementName=Root}" Value="{x:Static local:IconPosition.Left}">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Description, ElementName=Root}"
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ui:CardAction>
</UserControl>