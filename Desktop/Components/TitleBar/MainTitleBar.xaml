<UserControl x:Class="StreamBoard.Components.TitleBar.MainTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamBoard.Components.TitleBar"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    
    <ui:TitleBar Height="32" Padding="12,0,0,0">
        <ui:TitleBar.Icon>
            <ui:ImageIcon Source="pack://application:,,,/StreamBoard;component/Assets/Images/logo.ico" 
                          Margin="0,0,16,0" />
        </ui:TitleBar.Icon>

        <ui:TitleBar.Header>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           FontWeight="Regular" 
                           FontSize="12" 
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                           Margin="8,0,0,0" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           FontSize="12" 
                           FontWeight="Regular"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </ui:TitleBar.Header>
    </ui:TitleBar>
</UserControl>
