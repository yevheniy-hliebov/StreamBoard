<UserControl x:Class="StreamTabula.Components.Dialogs.BaseDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:StreamTabula.Components.Dialogs"
             xmlns:controls="clr-namespace:StreamTabula.Components.Controls"
             xmlns:titlebar="clr-namespace:StreamTabula.Components.TitleBar"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <titlebar:MainTitleBar Grid.Row="0"
                               Title="{Binding Title, ElementName=Root}"
                               ShowAppIcon="False"
                               ShowMinimize="False"
                               ShowMaximize="False" />

        <ContentPresenter Grid.Row="1"
                          Margin="{Binding ContentPadding, ElementName=Root}"
                          Content="{Binding DialogContent, ElementName=Root}" />

        <Border Grid.Row="2"
                Padding="{Binding ButtonsPadding, ElementName=Root}">
            <ContentPresenter Content="{Binding Buttons, ElementName=Root}" />
        </Border>

    </Grid>

</UserControl>
