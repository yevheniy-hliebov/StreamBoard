<UserControl x:Class="StreamTabula.Components.Controls.DropdownSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <ui:DropDownButton x:Name="MainDropDownButton"
                       Tag="{Binding ElementName=Root}"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Stretch"
                       Icon="{Binding IconName, ElementName=Root}">

        <ui:DropDownButton.Content>
            <TextBlock HorizontalAlignment="Stretch"
                       TextAlignment="Left">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text"
                                Value="{Binding SelectedItem.DisplayOption, ElementName=Root}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=Root}"
                                         Value="{x:Null}">
                                <Setter Property="Text"
                                        Value="{Binding PlaceholderText, ElementName=Root}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </ui:DropDownButton.Content>

        <ui:DropDownButton.Flyout>
            <ContextMenu MaxHeight="300"
                         Padding="0"
                         ItemsSource="{Binding PlacementTarget.Tag.ItemsSource, RelativeSource={RelativeSource Self}}">
                <ContextMenu.Template>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer Margin="2"
                                          CanContentScroll="True"
                                          Focusable="False"
                                          PanningMode="VerticalOnly"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter VerticalAlignment="Top" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ContextMenu.Template>

                <ContextMenu.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type MenuItem}}"
                           TargetType="MenuItem">
                        <EventSetter Event="Click"
                                     Handler="OnItemClick" />
                        <Setter Property="Header"
                                Value="{Binding DisplayOption}" />
                        <Setter Property="Padding"
                                Value="8,6" />
                    </Style>
                </ContextMenu.ItemContainerStyle>
            </ContextMenu>
        </ui:DropDownButton.Flyout>
    </ui:DropDownButton>
</UserControl>
