<UserControl x:Class="StreamBoard.Components.TitleBar.MainTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StreamBoard.Components.TitleBar"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <ui:TitleBar Height="32" Padding="12,0,0,0">
        <ui:TitleBar.Icon>
            <ui:ImageIcon Source="pack://application:,,,/StreamBoard;component/Assets/Images/logo.ico" 
              Margin="0,0,16,0" />
        </ui:TitleBar.Icon>

        <ui:TitleBar.Header>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="StreamBoard" 
               FontWeight="Regular" 
               FontSize="12" 
               VerticalAlignment="Center"/>

                <TextBlock Text="(v0.1.0)" 
               Margin="8,0,0,0" 
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
               FontSize="12" 
               FontWeight="Regular"
               VerticalAlignment="Center"/>
            </StackPanel>
        </ui:TitleBar.Header>
    </ui:TitleBar>
</UserControl>
