<UserControl x:Class="StreamBoard.Components.Controls.ConstrainedScrollBorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StreamBoard.Components.Controls"
             Name="Root">
    
    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="4"
            Padding="8"
            MinHeight="{Binding MinHeight, ElementName=Root}"
            MaxHeight="{Binding MaxHeight, ElementName=Root}"
            MinWidth="{Binding MinWidth, ElementName=Root}"
            MaxWidth="{Binding MaxWidth, ElementName=Root}">

        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <ContentPresenter Content="{Binding InnerContent, ElementName=Root}" />
        </ScrollViewer>
    </Border>
</UserControl>
