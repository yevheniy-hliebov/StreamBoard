<UserControl x:Class="StreamBoard.Components.Controls.IconButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:StreamBoard.Components.Controls"
             x:Name="Root">
    
    <ui:Button Appearance="Transparent"
           Padding="4"
           BorderThickness="0"
           Background="Transparent"
           ToolTip="{Binding TooltipText, ElementName=Root}"
           Command="{Binding Command, ElementName=Root}">
        <local:FluentIcon IconType="{Binding IconType, ElementName=Root}" FontSize="14" />
    </ui:Button>
</UserControl>
