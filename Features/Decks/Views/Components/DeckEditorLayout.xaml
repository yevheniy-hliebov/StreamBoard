<UserControl x:Class="StreamBoard.Features.Decks.Views.Components.DeckEditorLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StreamBoard.Features.Decks.Views.Components"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="220" MinWidth="200" MaxWidth="500"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="200" MinHeight="200" MaxHeight="400"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" MinWidth="150" MaxWidth="350"/>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="8,0,0,0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        ClipToBounds="True">

                    <ContentPresenter Content="{Binding LeftBarContent, ElementName=Root}" />
                </Border>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                              Background="Transparent" SnapsToDevicePixels="True"/>

                <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" 
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" SnapsToDevicePixels="True"/>

                <Border Grid.Column="2">
                    <ContentPresenter Content="{Binding CanvasContent, ElementName=Root}" />
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" 
                          Background="Transparent" SnapsToDevicePixels="True"/>
            <Border Grid.Row="1" Height="1" VerticalAlignment="Center" 
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" SnapsToDevicePixels="True"/>

            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ContentPresenter Content="{Binding PropertiesContent, ElementName=Root}" />
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                      Background="Transparent" SnapsToDevicePixels="True"/>
        <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" 
                Background="{DynamicResource DividerStrokeColorDefaultBrush}" SnapsToDevicePixels="True"/>

        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ContentPresenter Content="{Binding LibraryContent, ElementName=Root}" />
        </Border>

    </Grid>
</UserControl>
