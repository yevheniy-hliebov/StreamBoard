<UserControl x:Class="StreamBoard.Features.Decks.Views.Components.GridCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamBoard.Features.Decks.Views.Components"
             x:Name="Root">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Canvas x:Name="Viewport"
                Grid.Row="0" Grid.RowSpan="2"
                Background="Transparent"
                ClipToBounds="True"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">
            
            <Border x:Name="DeckSurface"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0,0">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="PanTransform"/>
                </Border.RenderTransform>


                <ItemsControl ItemsSource="{Binding Buttons}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding CanvasConfig.SelectedGrid.Rows}"
                                         Columns="{Binding CanvasConfig.SelectedGrid.Columns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:DeckButtonSlotView IsSelected="{Binding IsSelected}"
                                                      ButtonIndex="{Binding Index}"
                                                      ButtonName="{Binding Config.Name}"
                                                      ImagePath="{Binding Config.ImagePath}"
                                                      ButtonBackground="{Binding Config.BackgroundColor, FallbackValue=#2B2B2B}"
                                                      Command="{Binding DataContext.SelectButtonCommand, ElementName=Root}"
                                                      CommandParameter="{Binding}"
                                                      Margin="4"
                                                      Cursor="Hand"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </Border>
        </Canvas>

        <ComboBox Grid.Row="0" 
                  ItemsSource="{Binding CanvasConfig.Grids}"
                  SelectedItem="{Binding CanvasConfig.SelectedGrid, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Width="110"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  Margin="12"/>

    </Grid>
</UserControl>