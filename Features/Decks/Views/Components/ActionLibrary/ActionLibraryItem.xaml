<UserControl x:Class="StreamBoard.Features.Decks.Views.Components.ActionLibrary.ActionLibraryItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:StreamBoard.Components.Controls"
             x:Name="Root"
             Cursor="Hand">
    
    <Border x:Name="ItemBorder"
            CornerRadius="4"
            Padding="12,8"
            Margin="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Width="24"
                  Height="24"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center">
                
                <controls:FluentIcon IconType="{Binding Icon, ElementName=Root}"
                                     FontSize="16"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"/>
            </Grid>

            <TextBlock Grid.Column="1"
                       Text="{Binding Text, ElementName=Root}"
                       VerticalAlignment="Center"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</UserControl>