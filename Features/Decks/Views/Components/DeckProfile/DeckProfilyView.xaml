<UserControl x:Class="StreamBoard.Features.Decks.Views.Components.DeckProfile.DeckProfilyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
             xmlns:local="clr-namespace:StreamBoard.Features.Decks.Views.Components.DeckProfile"
             xmlns:layout="clr-namespace:StreamBoard.Features.Decks.Views.Components.Layout"
             xmlns:controls="clr-namespace:StreamBoard.Components.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="DragAdorner">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Opacity="0.7"
                    Padding="12,6"
                    MinWidth="150">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <layout:DeckSidebarHeader Grid.Row="0" Title="Pages">
            <layout:DeckSidebarHeader.RightContent>
                <StackPanel Orientation="Horizontal">
                    <controls:IconButton TooltipText="Add New Page" Command="{Binding AddPageCommand}" IconType="Add" />                    
                    <controls:IconButton TooltipText="Rename Page" Command="{Binding RenamePageCommand}" IconType="Rename" Margin="8,0,0,0"/>
                    <controls:IconButton TooltipText="Delete Page" Command="{Binding DeletePageCommand}" IconType="Delete" Margin="8,0,0,0"/>
                </StackPanel>
            </layout:DeckSidebarHeader.RightContent>
        </layout:DeckSidebarHeader>

        <ScrollViewer Grid.Row="1" 
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="True"
                      Padding="5">
            <ui:ListView ItemsSource="{Binding List}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         dd:DragDrop.IsDragSource="True"
                         dd:DragDrop.IsDropTarget="True"
                         dd:DragDrop.DropHandler="{Binding}"
                         dd:DragDrop.DragAdornerTemplate="{DynamicResource DragAdorner}">
                
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <local:DeckPageItem Title="{Binding Name, Mode=TwoWay}" Margin="0,2"/>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>
        </ScrollViewer>
    </Grid>
</UserControl>
