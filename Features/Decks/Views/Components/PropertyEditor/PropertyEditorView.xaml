<UserControl x:Class="StreamBoard.Features.Decks.Views.Components.PropertyEditor.PropertyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:StreamBoard.Features.Decks.Views.Components.PropertyEditor"
             xmlns:layout="clr-namespace:StreamBoard.Features.Decks.Views.Components.Layout"
             xmlns:controls="clr-namespace:StreamBoard.Components.Controls">

    <Grid Background="Transparent">

        <TextBlock Text="Select a key button"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   FontSize="16">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Canvas.SelectedButton}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Canvas.SelectedButton}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <layout:DeckSidebarHeader Grid.Row="0"
                                         Title="{Binding Canvas.SelectedButton.Index, StringFormat='Button Properties | Key: {0}'}">
                    <layout:DeckSidebarHeader.RightContent>
                        <controls:IconButton TooltipText="Reset Appearance" Command="{Binding Editor.ClearButtonCommand}" IconType="ClearAllInk"/>
                    </layout:DeckSidebarHeader.RightContent>
                </layout:DeckSidebarHeader>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="8">
                        <Label Content="Name" Margin="0,0,0,4"/>
                        <ui:TextBox PlaceholderText="Enter a name..."
                                    Text="{Binding Canvas.SelectedButton.Config.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="8">
                        <Label Content="Button Image" Margin="0,0,0,4"/>
                        <local:ImagePicker ImagePath="{Binding Canvas.SelectedButton.Config.ImagePath}" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8">
                        <Label Content="Background Color" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0" PlaceholderText="Enter a hex..."
                                        Height="35"
                                        Text="{Binding Canvas.SelectedButton.Config.BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,4,0"/>

                            <local:ColorPreview Grid.Column="1"
                                                SelectedColor="{Binding Canvas.SelectedButton.Config.BackgroundColor}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Separator Grid.Column="1"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <layout:DeckSidebarHeader Grid.Row="0" Title="Actions">
                    <layout:DeckSidebarHeader.RightContent>
                        <controls:IconButton TooltipText="Clear Actions" Command="{Binding Editor.ClearActionsCommand}" IconType="ClearAllInk"/>
                    </layout:DeckSidebarHeader.RightContent>
                </layout:DeckSidebarHeader>

                <local:ButtonActionListView Grid.Row="1"
                                            DataContext="{Binding}" 
                                            Margin="8"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>