<UserControl x:Class="StreamBoard.Features.Decks.Views.Components.PropertyEditor.ButtonActionItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StreamBoard.Components.Controls"
             x:Name="Root">
    
    <Border CornerRadius="4"
            Padding="5">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Width="22"
                  Height="22"
                  Margin="0,0,4,0"
                  VerticalAlignment="Center">

                <controls:FluentIcon IconType="{Binding Icon, ElementName=Root}"
                                     FontSize="14"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"/>
            </Grid>

            <TextBlock Grid.Column="1"
                       Text="{Binding Text, ElementName=Root}"
                       VerticalAlignment="Center"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <controls:IconButton Grid.Column="2" 
                                 IconType="Delete"
                                 TooltipText="Delete Action"
                                 VerticalAlignment="Center"
                                 Margin="4,0,0,0"
                                 Command="{Binding DeleteCommand, ElementName=Root}"
                                 CommandParameter="{Binding ActionId, ElementName=Root}"/>
        </Grid>
    </Border>
</UserControl>
