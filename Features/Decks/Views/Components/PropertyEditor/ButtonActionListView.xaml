<UserControl x:Class="StreamBoard.Features.Decks.Views.Components.PropertyEditor.ButtonActionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamBoard.Features.Decks.Views.Components.PropertyEditor"
             xmlns:controls="clr-namespace:StreamBoard.Components.Controls">

    <controls:ConstrainedScrollBorder>
        <ItemsControl ItemsSource="{Binding SelectedButton.Config.Actions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:ButtonActionItem
                        Icon="{Binding Metadata.Icon}"
                        Text="{Binding Label}"
                        ActionId="{Binding Id}"
                        DeleteCommand="{Binding DataContext.DeleteActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </controls:ConstrainedScrollBorder>
</UserControl>