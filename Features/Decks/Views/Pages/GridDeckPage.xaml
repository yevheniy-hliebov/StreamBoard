<Page x:Class="StreamBoard.Features.Decks.Views.Pages.GridDeckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StreamBoard.Features.Decks.Views.Pages"
      xmlns:layout="clr-namespace:StreamBoard.Features.Decks.Views.Components.Layout"
      xmlns:deck_profile="clr-namespace:StreamBoard.Features.Decks.Views.Components.DeckProfile"
      xmlns:canvas="clr-namespace:StreamBoard.Features.Decks.Views.Components.Canvas"
      xmlns:action_library="clr-namespace:StreamBoard.Features.Decks.Views.Components.ActionLibrary"
      xmlns:property_editor="clr-namespace:StreamBoard.Features.Decks.Views.Components.PropertyEditor"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GridDeckPage"
      ScrollViewer.CanContentScroll="False">

    <layout:DeckEditorLayout VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

        <layout:DeckEditorLayout.LeftBarContent>
            <deck_profile:DeckProfilyView DataContext="{Binding Pages}"/>
        </layout:DeckEditorLayout.LeftBarContent>

        <layout:DeckEditorLayout.CanvasContent>
            <canvas:GridCanvasView DataContext="{Binding}"/>
        </layout:DeckEditorLayout.CanvasContent>

        <layout:DeckEditorLayout.PropertiesContent>
            <property_editor:PropertyEditorView DataContext="{Binding}"/>
        </layout:DeckEditorLayout.PropertiesContent>

        <layout:DeckEditorLayout.LibraryContent>
            <action_library:ActionLibraryView DataContext="{Binding Library}" />
        </layout:DeckEditorLayout.LibraryContent>

    </layout:DeckEditorLayout>
</Page>
