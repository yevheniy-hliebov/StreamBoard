<Page x:Class="StreamBoard.Features.Decks.Views.Pages.GridDeckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StreamBoard.Features.Decks.Views.Pages"
      xmlns:components="clr-namespace:StreamBoard.Features.Decks.Views.Components"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GridDeckPage">

    <components:DeckEditorLayout>

        <components:DeckEditorLayout.LeftBarContent>
            <components:DeckProfilyView DataContext="{Binding Profile.Pages}"/>
        </components:DeckEditorLayout.LeftBarContent>

        <components:DeckEditorLayout.CanvasContent>
            <TextBlock Text="GRID BUTTONS HERE" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </components:DeckEditorLayout.CanvasContent>

        <components:DeckEditorLayout.PropertiesContent>
            <TextBlock Text="PROPERTIES EDITOR" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </components:DeckEditorLayout.PropertiesContent>

        <components:DeckEditorLayout.LibraryContent>
            <components:ActionLibraryView DataContext="{Binding Library}" />
        </components:DeckEditorLayout.LibraryContent>

    </components:DeckEditorLayout>
</Page>
